# Copier ce fichier en `.env` puis renseigner les valeurs réelles.
# `.env` n'est jamais versionné : il contient des identifiants de production.

# ── Base de données ──────────────────────────────────────────
# Développement local : fichier SQLite.
# Prisma lit toujours cette variable pour générer le client et le SQL,
# même lorsque l'application vise Turso.
DATABASE_URL="file:./dev.db"

# Production (Vercel) : Turso. Dès que TURSO_DATABASE_URL est présent,
# l'application et les scripts basculent sur l'adaptateur libSQL.
# Le système de fichiers de Vercel étant éphémère, SQLite local n'y fonctionne pas.
# TURSO_DATABASE_URL="libsql://<base>-<organisation>.turso.io"
# TURSO_AUTH_TOKEN="<jeton>"

# ── Sessions ─────────────────────────────────────────────────
# Générer une chaîne aléatoire de 32+ caractères (ne pas réutiliser celle du dev)
JWT_SECRET="remplacer-par-une-chaine-aleatoire-longue"
JWT_EXPIRES_IN="8h"
SESSION_TIMEOUT_MINUTES="60"

# ── ERP Microsoft Dynamics NAV / Business Central (OData V4) ──
# Authentification Basic (NavUserPassword).
# À ne renseigner que sur la machine qui exécute `npm run erp:sync` :
# le serveur NAV est sur le réseau interne, donc injoignable depuis Vercel.
ERP_BASE_URL="http://<serveur>:<port>/<instance>/ODataV4"
ERP_COMPANY="<nom de la société>"
ERP_USER="<utilisateur>"
ERP_PASSWORD="<mot de passe>"
